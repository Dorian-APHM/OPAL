# OPAL Environment Configuration
# Copy this file to .env and adjust values for your environment.
#
#   cp .env.example .env
#   # Edit .env with your values, then:
#   docker compose up -d
#
# NOTE: only the variables below are read by docker-compose.yml. Values like the
# Keycloak realm/client, AUTH_ENABLED, and the host ports are now hardcoded in
# the compose file (they never change per install), so they no longer belong here.

# ============================================================
# SECURITY (REQUIRED — deployment fails if unset)
# ============================================================

# Encryption key for CDM passwords stored in the app database.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Keycloak admin console credentials (realm "master").
# Used by the backend to manage OPAL users via the Keycloak API.
#
# SÉCURITÉ (S03) : KEYCLOAK_ADMIN_PASSWORD est OBLIGATOIRE.
# Le déploiement échoue (`:?` dans docker-compose.yml) si cette valeur est absente.
# Ne jamais utiliser "admin" ou un mot de passe trivial en production.
# Respectez la policy du realm opal : >=8 caractères, 1 chiffre, 1 majuscule, 1 spécial.
# Générez un mot de passe fort avec : openssl rand -base64 32
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# ============================================================
# DATABASE
# ============================================================

# Internal app database (opal-db container).
POSTGRES_USER=opal
POSTGRES_PASSWORD=
POSTGRES_DB=opal

# Host port mapped to the app DB (container always listens on 5432).
DB_EXTERNAL_PORT=5434

# ============================================================
# ENVIRONMENT
# ============================================================

# Set to "production" to enforce security checks (AUTH_ENABLED must be true, etc.)
# Set to "development" for local dev.
ENVIRONMENT=development

# ============================================================
# ACCESS / NETWORKING
# ============================================================

# Public hostname or IP by which users (and their browsers) reach this server.
# Drives KEYCLOAK_ISSUER_URL and CORS_ORIGINS automatically (see docker-compose.yml).
# Use "localhost" for a single-machine setup; otherwise the server's FQDN or IP.
# Example: opal.hospital.fr  or  10.64.48.194
EXTERNAL_HOSTNAME=localhost

# ============================================================
# AUTHENTICATION
# ============================================================

# Enable Keycloak LDAP user federation (federated directory login).
KEYCLOAK_LDAP_ENABLED=false

# ============================================================
# PROXY (optional — only needed behind a corporate proxy)
# ============================================================

# HTTP_PROXY=http://localhost:3128
# HTTPS_PROXY=http://localhost:3128

# ============================================================
# PERFORMANCE TUNING (optional)
# ============================================================

# OMOP CDM connection pool (per CDM)
# OMOP_POOL_MIN_CONN=2
# OMOP_POOL_MAX_CONN=20
# OMOP_POOL_IDLE_TIMEOUT=1800
# OMOP_STATEMENT_TIMEOUT_MS=1800000

# App DB connection pool
# APP_DB_POOL_SIZE=10
# APP_DB_MAX_OVERFLOW=20
# APP_DB_POOL_RECYCLE=1800

# Background worker threads
# MAX_WORKER_THREADS=16

# ============================================================
# OHDSI INTEGRATION (optional)
# ============================================================
#
# The OHDSI tools run in a dedicated runner service (no Docker socket). Two modes:
#   off (default) — feature disabled, OHDSI tab hidden.
#   on            — backend talks to opal-ohdsi-runner; start it with the profile:
#                     docker compose --profile ohdsi up -d
#
# When OHDSI_MODE=on you MUST set OHDSI_RUNNER_TOKEN (shared backend<->runner secret).
OHDSI_MODE=off

# Shared token authenticating the backend to the runner. Generate with:
#   openssl rand -hex 32
OHDSI_RUNNER_TOKEN=

# Max OHDSI jobs running concurrently in the runner (optional).
# OHDSI_MAX_CONCURRENT_JOBS=2
