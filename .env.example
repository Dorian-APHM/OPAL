# OPAL Environment Configuration
# Copy this file to .env and adjust values for your environment.
#
#   cp .env.example .env
#   # Edit .env with your values, then:
#   docker compose up -d

# ============================================================
# SECURITY (REQUIRED for production)
# ============================================================

# Encryption key for CDM passwords stored in the app database.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Keycloak admin console credentials (realm "master").
# Used by the backend to manage OPAL users via Keycloak API.
#
# SÉCURITÉ (S03) : KEYCLOAK_ADMIN_PASSWORD est OBLIGATOIRE.
# Le déploiement échoue (`:?` dans docker-compose.yml) si cette valeur est absente.
# Ne jamais utiliser "admin" ou un mot de passe trivial en production.
# Générez un mot de passe fort avec : openssl rand -base64 32
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# ============================================================
# DATABASE
# ============================================================

# Internal app database (opal-db container).
POSTGRES_USER=opal
POSTGRES_PASSWORD=opal
POSTGRES_DB=opal

# ============================================================
# ENVIRONMENT
# ============================================================

# Set to "production" to enforce security checks (AUTH_ENABLED must be true, etc.)
# Set to "development" for local dev (allows AUTH_ENABLED=false with warnings).
ENVIRONMENT=development

# ============================================================
# AUTHENTICATION
# ============================================================

AUTH_ENABLED=true
KEYCLOAK_REALM=opal
KEYCLOAK_CLIENT_ID=opal-frontend

# Public URL of Keycloak as seen by browsers (for JWT issuer verification).
# Must match the URL users use to reach Keycloak (hostname, port, protocol).
# Example: http://myserver.hospital.fr:8080
KEYCLOAK_ISSUER_URL=http://localhost:8080

# ============================================================
# NETWORKING
# ============================================================

# Ports exposed on the host machine.
FRONTEND_PORT=3000
KEYCLOAK_PORT=8080

# Comma-separated list of allowed CORS origins.
# Add all URLs from which users access OPAL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# OHDSI INTEGRATION (optional)
# ============================================================

# Defaults are set in docker-compose.yml using ${PWD} for portability.
# Only override if your layout differs from the standard project structure.
# OHDSI_IMAGE_PREFIX=ohdsi-docker
# OHDSI_HOST_OUTPUT_DIR=          # Default: ${PWD}/ohdsi_output
# OHDSI_HOST_SCRIPTS_DIR=         # Default: ${PWD}/ohdsi-tools/scripts
# OHDSI_HOST_JDBC_DIR=            # Default: ${PWD}/ohdsi-tools/drivers

# GID of the Docker socket on the host (for OHDSI container orchestration).
# Find it with: stat -c '%g' /var/run/docker.sock
# DOCKER_GID=140
