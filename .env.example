# OPAL Environment Configuration
# Copy this file to .env and adjust values for your environment.
#
#   cp .env.example .env
#   # Edit .env with your values, then:
#   docker compose up -d
#
# NOTE: only the variables below are read by docker-compose.yml. Values like the
# Keycloak realm/client, AUTH_ENABLED, and the host ports are now hardcoded in
# the compose file (they never change per install), so they no longer belong here.

# ============================================================
# SECURITY (REQUIRED — deployment fails if unset)
# ============================================================

# Encryption key for CDM passwords stored in the app database.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Keycloak admin console credentials (realm "master").
# Used by the backend to manage OPAL users via the Keycloak API.
#
# SÉCURITÉ (S03) : KEYCLOAK_ADMIN_PASSWORD est OBLIGATOIRE.
# Le déploiement échoue (`:?` dans docker-compose.yml) si cette valeur est absente.
# Ne jamais utiliser "admin" ou un mot de passe trivial en production.
# Respectez la policy du realm opal : >=8 caractères, 1 chiffre, 1 majuscule, 1 spécial.
# Générez un mot de passe fort avec : openssl rand -base64 32
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# ============================================================
# DATABASE
# ============================================================

# Internal app database (opal-db container).
POSTGRES_USER=opal
POSTGRES_PASSWORD=
POSTGRES_DB=opal

# Host port mapped to the app DB (container always listens on 5432).
DB_EXTERNAL_PORT=5434

# ============================================================
# ENVIRONMENT
# ============================================================

# Set to "production" to enforce security checks (AUTH_ENABLED must be true, etc.)
# Set to "development" for local dev.
ENVIRONMENT=development

# ============================================================
# ACCESS / NETWORKING
# ============================================================

# Public hostname or IP by which users (and their browsers) reach this server.
# Drives KEYCLOAK_ISSUER_URL and CORS_ORIGINS automatically (see docker-compose.yml).
# Use "localhost" for a single-machine setup; otherwise the server's FQDN or IP.
# Example: opal.hospital.fr  or  192.0.2.10
EXTERNAL_HOSTNAME=localhost

# ============================================================
# AUTHENTICATION
# ============================================================

# Enable Keycloak LDAP user federation (federated directory login).
KEYCLOAK_LDAP_ENABLED=false

# ============================================================
# PROXY (optional — only needed behind a corporate proxy)
# ============================================================

# HTTP_PROXY=http://localhost:3128
# HTTPS_PROXY=http://localhost:3128

# ============================================================
# PERFORMANCE TUNING (optional)
# ============================================================

# OMOP CDM connection pool (per CDM)
# OMOP_POOL_MIN_CONN=2
# OMOP_POOL_MAX_CONN=20
# OMOP_POOL_IDLE_TIMEOUT=1800
# OMOP_STATEMENT_TIMEOUT_MS=1800000

# App DB connection pool
# APP_DB_POOL_SIZE=10
# APP_DB_MAX_OVERFLOW=20
# APP_DB_POOL_RECYCLE=1800

# Background worker threads
# MAX_WORKER_THREADS=16

# ============================================================
# OHDSI INTEGRATION (optional)
# ============================================================
#
# The OHDSI tools run in a dedicated runner service (no Docker socket). Two modes:
#   off (default) — feature disabled, OHDSI tab hidden.
#   on            — backend talks to opal-ohdsi-runner; start it with the profile:
#                     docker compose --profile ohdsi up -d
#
# OHDSI_RUNNER_TOKEN is REQUIRED only when OHDSI_MODE=on. When OHDSI_MODE=off
# (the default) you can leave it empty — it is not needed and all docker compose
# commands (up/down/ps) work fine without it.
OHDSI_MODE=off

# Shared token authenticating the backend to the runner. Only needed when
# OHDSI_MODE=on; leave empty otherwise. Generate with:
#   openssl rand -hex 32
OHDSI_RUNNER_TOKEN=

# Max OHDSI jobs running concurrently in the runner (optional).
# OHDSI_MAX_CONCURRENT_JOBS=2

# ============================================================
# COHORT-LLM (natural-language -> cohort draft, optional)
# ============================================================
#
# Runs in the opal-llm service (RAG over source_value_cache + LLM generation).
# Three modes; start the service with:  docker compose --profile cohort-llm up -d
#   off         -> feature disabled, "AI assistant" tab hidden (nothing required here)
#   embedded    -> bundled local model; Ollama pulls it on first run (no key needed)
#   on-premise  -> uses YOUR OpenAI-compatible LLM. Configure the endpoint/model/key
#                  in the app UI (Settings, admin) — NOT here; the key is encrypted in DB.
COHORT_LLM_MODE=off

# Embedded model pulled on first run (embedded mode only). Any Ollama tag.
# COHORT_LLM_EMBEDDED_MODEL=qwen2.5:7b-instruct-q4_K_M

# Device for the embedded LLM (Ollama, embedded mode only): cuda (default) or cpu.
# RAG embeddings no longer run here — they come from the opal-sapbert runner.
# Set to cpu if the host has no NVIDIA container runtime.
# COHORT_LLM_DEVICE=cuda

# ============================================================
# SAPBERT — shared medical embedder (ON BY DEFAULT)
# ============================================================
#
# Independent module (orthogonal to COHORT_LLM_MODE). The opal-sapbert service runs
# the multilingual SapBERT model and is the SINGLE embedder for two features:
#   - mapping suggestions  (source labels -> standard OMOP concepts -> sapbert_mappings)
#   - cohort-llm RAG        (concept-set retrieval for the AI cohort assistant)
#
# COMPOSE_PROFILES below starts it by default. To DISABLE the module entirely:
#   1. remove "sapbert" from COMPOSE_PROFILES (the container won't start), and
#   2. set SAPBERT_MODE=off (the backend stops calling it).
# Impact when OFF:
#   - Mapping  : loses the SapBERT auto-mapping strategy; the 5 other strategies
#                (exact, relationship, keyword, fuzzy, contextual) still work.
#   - Cohort AI: criteria extraction still works, but concept-sets are NOT auto-filled
#                (no semantic retrieval) — the user fills them manually.
SAPBERT_MODE=on

# Active Compose profiles (comma-separated). "sapbert" => opal-sapbert starts with a
# plain `docker compose up -d`. Add "cohort-llm" and/or "ohdsi" to enable those too;
# remove "sapbert" to keep the module off. CLI `--profile X` flags add to this list.
COMPOSE_PROFILES=sapbert

# Shared token authenticating the backend to the runner. Only needed when
# SAPBERT_MODE=on; leave empty otherwise. Generate with: openssl rand -hex 32
SAPBERT_RUNNER_TOKEN=

# Device for the SapBERT encoder: cuda (default) or cpu.
# Set to cpu if the host has no NVIDIA container runtime.
# SAPBERT_DEVICE=cuda

# HuggingFace model id. Changing this requires rebuilding opal-sapbert
# (the model is baked into the image): docker compose --profile sapbert build
# SAPBERT_MODEL=cambridgeltl/SapBERT-UMLS-2020AB-all-lang-from-XLMR
