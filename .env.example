# OPAL Environment Configuration
# Copy this file to .env and adjust values for your environment.
#
#   cp .env.example .env
#   # Edit .env with your values, then:
#   docker compose up -d

# ============================================================
# SECURITY (REQUIRED for production)
# ============================================================

# Encryption key for CDM passwords stored in the app database.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Keycloak admin console credentials (realm "master").
# Used by the backend to manage OPAL users via Keycloak API.
# IMPORTANT: Change these BEFORE first deployment in production.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ============================================================
# DATABASE
# ============================================================

# Internal app database (opal-db container).
POSTGRES_USER=opal
POSTGRES_PASSWORD=opal
POSTGRES_DB=opal

# ============================================================
# ENVIRONMENT
# ============================================================

# Set to "production" to enforce security checks (AUTH_ENABLED must be true, etc.)
# Set to "development" for local dev (allows AUTH_ENABLED=false with warnings).
ENVIRONMENT=development

# ============================================================
# AUTHENTICATION
# ============================================================

AUTH_ENABLED=true
KEYCLOAK_REALM=opal
KEYCLOAK_CLIENT_ID=opal-frontend

# Public URL of Keycloak as seen by browsers (for JWT issuer verification).
# Must match the URL users use to reach Keycloak (hostname, port, protocol).
# Example: http://myserver.hospital.fr:8080
KEYCLOAK_ISSUER_URL=http://localhost:8080

# ============================================================
# NETWORKING
# ============================================================

# Ports exposed on the host machine.
FRONTEND_PORT=3000
KEYCLOAK_PORT=8080

# Comma-separated list of allowed CORS origins.
# Add all URLs from which users access OPAL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# OHDSI INTEGRATION (optional)
# ============================================================

OHDSI_IMAGE_PREFIX=ohdsi-docker
OHDSI_HOST_OUTPUT_DIR=
OHDSI_HOST_SCRIPTS_DIR=
OHDSI_HOST_JDBC_DIR=/data/jdbc_drivers
