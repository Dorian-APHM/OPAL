# OHDSI tools runtime config.
# Copy to .env and fill in. The OPAL backend overrides DB_* per CDM when it
# launches a container, so the values below are mostly defaults / fallbacks.

DB_SYSTEM=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

CDM_SCHEMA=omop_cdm
RESULTS_SCHEMA=omop_cdm
VOCABULARY_SCHEMA=omop_cdm
CDM_VERSION=5.4
CDM_SOURCE_NAME=Database

# JDBC driver path inside the container — must match the volume mount in docker-compose.yml.
PATH_TO_DRIVER=/drivers
